# Pico state: database, Pi profile and sessions. Default: ~/.local/share/pico
# PICO_DATA_DIR=/absolute/path

# Laboratory workspaces, one folder per lab. Default: ~/pico-labs
# PICO_LABS_DIR=/absolute/path

# Pico's private Pi profile. Default: <PICO_DATA_DIR>/pi
# PICO_PI_AGENT_DIR=/absolute/path

PICO_PORT=4317
# PICO_HOST=127.0.0.1

# Web search defaults to Exa's public endpoint. Pick another provider in
# <PICO_DATA_DIR>/pi/web-search.json and set its key here.
# SERPER_API_KEY=
# SERPAPI_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
