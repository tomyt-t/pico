# Pico state: database and Claude Code profile. Default: ~/.local/share/pico
# PICO_DATA_DIR=/absolute/path

# Laboratory workspaces, one folder per lab. Default: ~/pico-labs
# PICO_LABS_DIR=/absolute/path

# Pico's private Claude Code profile: subscription login and conversations.
# Sign in with bun run login. Default: <PICO_DATA_DIR>/claude
# PICO_CLAUDE_CONFIG_DIR=/absolute/path

PICO_PORT=4317
# PICO_HOST=127.0.0.1

# Pico runs only on a Claude subscription. ANTHROPIC_API_KEY,
# ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL and CLAUDE_CODE_USE_BEDROCK,
# _VERTEX or _FOUNDRY are removed before Claude Code starts; setting them
# here has no effect.
