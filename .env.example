# Research data stays outside the application source tree.
# PICO_DATA_DIR=/absolute/path/to/pico-research
PICO_PORT=4317

# Pico owns its Pi profile. Default: <PICO_DATA_DIR>/pi.
# PI_CODING_AGENT_DIR from your personal Pi is ignored by Pico.
# PICO_PI_AGENT_DIR=/absolute/path/to/pico-profile

# Web search defaults to Exa's public MCP endpoint (no key required).
# Select a provider in <PICO_DATA_DIR>/pi/web-search.json; restart Pico after edits.
# Google results: provider "serper" or "serpapi", with its corresponding key.
# SERPER_API_KEY=
# SERPAPI_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=

# Only for Advanced OpenAI-compatible API mode; Pi uses Pico's own sign-in.
# PICO_MODEL_API_KEY=
